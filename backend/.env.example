# 复制本文件为 .env（同目录），填入你的 Key 后重启后端
# .env 不要提交进仓库

# 智谱开放平台 Key（GLM-4V-Flash 图片识别用，免费）申请：https://open.bigmodel.cn/
ZHIPU_API_KEY=

# DeepSeek Key（对话与笔记生成用，M2/M3 生效）申请：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 模型名（可选，有默认值；换模型改这里即可，不用改代码）
ZHIPU_MODEL=glm-4v-flash
DEEPSEEK_MODEL=deepseek-chat
